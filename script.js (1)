(function(){
  /* ---------- Splash (3s) ---------- */
  var splash = document.getElementById('splash');
  window.addEventListener('load', function(){ setTimeout(function(){ splash.classList.add('hide'); }, 3000); });

  /* ---------- Header ---------- */
  var header = document.getElementById('siteHeader');
  var menuBtn = document.getElementById('menuBtn');
  function onScroll(){ header.classList.toggle('scrolled', window.scrollY > 40); }
  window.addEventListener('scroll', onScroll, {passive:true}); onScroll();
  menuBtn.addEventListener('click', function(){
    var open = header.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.querySelectorAll('#navLinks a').forEach(function(a){
    a.addEventListener('click', function(){ header.classList.remove('open'); menuBtn.setAttribute('aria-expanded','false'); });
  });

  /* ---------- Countdown to 10 December 2026 (00:00, Nigeria time) ---------- */
  var target = new Date('2026-12-10T00:00:00+01:00').getTime();
  var els = {d:document.getElementById('cd-days'), h:document.getElementById('cd-hours'), m:document.getElementById('cd-mins'), s:document.getElementById('cd-secs')};
  function pad(n){ return String(n).padStart(2,'0'); }
  function tick(){
    var diff = Math.max(0, target - Date.now());
    els.d.textContent = pad(Math.floor(diff / 86400000));
    els.h.textContent = pad(Math.floor(diff % 86400000 / 3600000));
    els.m.textContent = pad(Math.floor(diff % 3600000 / 60000));
    els.s.textContent = pad(Math.floor(diff % 60000 / 1000));
  }
  tick(); setInterval(tick, 1000);

  /* ---------- Gallery coverflow ---------- */
  var stage = document.getElementById('cfStage');
  var items = Array.prototype.slice.call(stage.querySelectorAll('.cf-item'));
  var dotsWrap = document.getElementById('cfDots');
  var n = items.length, active = 0, timer = null;
  items.forEach(function(_, i){
    var d = document.createElement('div');
    d.className = 'cf-dot' + (i === 0 ? ' active' : '');
    d.addEventListener('click', function(){ go(i); restart(); });
    dotsWrap.appendChild(d);
  });
  var dots = Array.prototype.slice.call(dotsWrap.children);
  function shortest(i){ var d = i - active; if (d > n/2) d -= n; if (d < -n/2) d += n; return d; }
  function render(){
    var gap = stage.clientWidth < 600 ? 92 : 190;
    items.forEach(function(item, i){
      var diff = shortest(i), abs = Math.abs(diff);
      item.classList.toggle('is-active', diff === 0);
      if (abs > 3){
        item.style.opacity = '0'; item.style.pointerEvents = 'none';
        item.style.transform = 'translateX(' + (diff > 0 ? 1 : -1) * 900 + 'px) scale(.5)';
        return;
      }
      item.style.pointerEvents = 'auto';
      item.style.transform = 'translateX(' + diff * gap + 'px) scale(' + (1 - abs * .14) + ') rotateY(' + (diff * -22) + 'deg)';
      item.style.zIndex = n - abs;
      item.style.opacity = String(1 - abs * .28);
      item.style.filter = diff === 0 ? 'brightness(1)' : 'brightness(.55)';
    });
    dots.forEach(function(d, i){ d.classList.toggle('active', i === active); });
  }
  function go(i){ active = (i + n) % n; render(); }
  function restart(){ clearInterval(timer); timer = setInterval(function(){ go(active + 1); }, 2800); }
  document.getElementById('cfNext').addEventListener('click', function(){ go(active + 1); restart(); });
  document.getElementById('cfPrev').addEventListener('click', function(){ go(active - 1); restart(); });
  items.forEach(function(item, i){ item.addEventListener('click', function(){ go(i); restart(); }); });
  var dragging = false, startX = 0;
  stage.addEventListener('pointerdown', function(e){ dragging = true; startX = e.clientX; clearInterval(timer); });
  window.addEventListener('pointerup', function(e){
    if (!dragging) return; dragging = false;
    var dx = e.clientX - startX;
    if (dx > 40) go(active - 1); else if (dx < -40) go(active + 1);
    restart();
  });
  stage.addEventListener('mouseenter', function(){ clearInterval(timer); });
  stage.addEventListener('mouseleave', function(){ if (!dragging) restart(); });
  window.addEventListener('resize', render);
  render(); restart();

  /* ---------- Only one reel video plays at a time ---------- */
  var vids = Array.prototype.slice.call(document.querySelectorAll('.reel video'));
  vids.forEach(function(v){
    v.addEventListener('play', function(){ vids.forEach(function(o){ if (o !== v) o.pause(); }); });
  });
})();


/* ============================================================
   MERCH + CART  (edit the two settings below)
   ============================================================ */
(function(){
  /* 1) The admin WhatsApp number. Country code, no "+" and no leading 0.
        09044355752  ->  2349044355752 */
  var WHATSAPP_NUMBER = '2349044355752';

  /* 2) Your products. To add one, copy a block and change it.
        - category: 'caps' or 'shirts' (matches the filter chips)
        - price: in Naira, numbers only
        - image: put the photo in images/merch/ with this exact file name
        - options: sizes etc. Set to null if the item has no choices. */
  var PRODUCTS = [
    {
      id: 'cap', category: 'caps', name: 'MAMG Cap', price: 12000,
      image: 'cap.png', cutout: true,
      desc: 'The official MAMG cap, in four styles. Same energy, new fits.',
      options: { label: 'Style', values: ['Washed Black','Cream','Purple','Black Snapback','Camo'] }
    },
   /* {
      id: 'tee', category: 'shirts', name: 'MAMG Tee', price: 12000,
      image: 'images/merch/mamg-tee.jpg',
      desc: 'The official MAMG shirt, made for the whole crew.',
      options: { label: 'Size', values: ['S','M','L','XL','XXL'] }
    }*/
  ];

  /* ---------------- no need to edit below this line ---------------- */
  var STORAGE_KEY = 'mamg_cart_v1', NAME_KEY = 'mamg_cart_name';
  var CAT_LABEL = { caps: 'Cap', shirts: 'Shirt' };
  var $ = function(id){ return document.getElementById(id); };
  var grid = $('merchGrid'), how = $('merchHow');
  var fab = $('cartFab'), countEl = $('cartCount'), overlay = $('cartOverlay'), drawer = $('cartDrawer');
  var body = $('cartBody'), foot = $('cartFoot'), totalEl = $('cartTotal'), checkout = $('cartCheckout');
  var nameInput = $('cartName'), toast = $('cartToast');
  var cart = [], lastFocus = null, toastTimer = null;

  function fmt(n){ return '₦' + Number(n).toLocaleString('en-NG'); }
  function esc(s){ return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function product(id){ for (var i=0;i<PRODUCTS.length;i++) if (PRODUCTS[i].id === id) return PRODUCTS[i]; return null; }

  /* ---------- storage ---------- */
  function save(){ try { localStorage.setItem(STORAGE_KEY, JSON.stringify(cart)); } catch(e){} }
  function load(){
    try {
      var raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      cart = raw.filter(function(it){ return it && product(it.id) && it.qty > 0; }).map(function(it){
        var p = product(it.id);
        if (p.options && p.options.values.indexOf(it.option) === -1) return null;
        return { id: p.id, option: it.option || '', qty: Math.min(99, Math.floor(it.qty)) };
      }).filter(Boolean);
      nameInput.value = localStorage.getItem(NAME_KEY) || '';
    } catch(e){ cart = []; }
  }

  /* ---------- product grid ---------- */
  function mediaHTML(p, cls){
    return '<img class="ph" src="images/logo.png" alt="">' +
           '<img class="photo' + (p.cutout ? ' cutout' : '') + '" src="' + esc(p.image) + '" alt="' + esc(p.name) + '" loading="lazy" onload="this.parentNode.classList.add(\'has-photo\')" onerror="this.remove()">';
  }
  function renderProducts(filter){
    Array.prototype.slice.call(grid.querySelectorAll('.product')).forEach(function(n){ n.remove(); });
    PRODUCTS.forEach(function(p){
      if (filter !== 'all' && p.category !== filter) return;
      var el = document.createElement('article');
      el.className = 'product'; el.dataset.id = p.id;
      var opts = '';
      if (p.options){
        opts = '<div><span class="mono opt-label">' + esc(p.options.label) + '</span>' +
          '<div class="sizes" role="radiogroup" aria-label="' + esc(p.options.label) + '">' +
          p.options.values.map(function(v){ return '<button type="button" class="size" role="radio" aria-checked="false" data-v="' + esc(v) + '">' + esc(v) + '</button>'; }).join('') +
          '</div><div class="opt-error" aria-live="polite"></div></div>';
      }
      el.innerHTML =
        '<div class="product-media">' + mediaHTML(p) + '<span class="product-tag mono">' + esc(CAT_LABEL[p.category] || p.category) + '</span></div>' +
        '<div class="product-body">' +
          '<div class="product-top"><h3>' + esc(p.name) + '</h3><span class="price">' + fmt(p.price) + '</span></div>' +
          '<p>' + esc(p.desc) + '</p>' + opts +
          '<button type="button" class="btn btn-solid add-btn">Add to cart <span class="arr">+</span></button>' +
        '</div>';
      grid.insertBefore(el, how);
    });
    how.hidden = (filter !== 'all');
  }

  grid.addEventListener('click', function(e){
    var size = e.target.closest('.size');
    if (size){
      var group = size.parentNode;
      Array.prototype.forEach.call(group.querySelectorAll('.size'), function(b){ b.setAttribute('aria-checked', b === size ? 'true' : 'false'); });
      group.classList.remove('need');
      var err = group.parentNode.querySelector('.opt-error'); if (err) err.textContent = '';
      return;
    }
    var add = e.target.closest('.add-btn');
    if (!add) return;
    var card = add.closest('.product'), p = product(card.dataset.id), option = '';
    if (p.options){
      var sel = card.querySelector('.size[aria-checked="true"]');
      if (!sel){
        var g = card.querySelector('.sizes'); g.classList.remove('need'); void g.offsetWidth; g.classList.add('need');
        card.querySelector('.opt-error').textContent = 'Pick a ' + p.options.label.toLowerCase() + ' first.';
        return;
      }
      option = sel.dataset.v;
    }
    addToCart(p, option);
  });

  document.querySelectorAll('.chip').forEach(function(chip){
    chip.addEventListener('click', function(){
      document.querySelectorAll('.chip').forEach(function(c){ c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'); });
      renderProducts(chip.dataset.filter);
    });
  });

  /* ---------- cart logic ---------- */
  function findLine(id, option){ for (var i=0;i<cart.length;i++) if (cart[i].id === id && cart[i].option === option) return cart[i]; return null; }
  function addToCart(p, option){
    var line = findLine(p.id, option);
    if (line) line.qty = Math.min(99, line.qty + 1); else cart.push({ id: p.id, option: option, qty: 1 });
    save(); renderCart();
    fab.classList.remove('bump'); void fab.offsetWidth; fab.classList.add('bump');
    showToast(p.name + (option ? ' (' + option + ')' : '') + ' added to cart');
  }
  function total(){ return cart.reduce(function(s, it){ return s + product(it.id).price * it.qty; }, 0); }
  function count(){ return cart.reduce(function(s, it){ return s + it.qty; }, 0); }

  function buildMessage(){
    var lines = ['Hello MAMG! I would like to order from the website:', ''];
    cart.forEach(function(it, i){
      var p = product(it.id);
      lines.push((i + 1) + '. ' + p.name + (it.option ? ' (' + p.options.label + ': ' + it.option + ')' : '') + ' × ' + it.qty + ' = ' + fmt(p.price * it.qty));
    });
    lines.push('', 'Total: ' + fmt(total()));
    var name = nameInput.value.trim();
    if (name) lines.push('', 'Name: ' + name);
    lines.push('', 'Please confirm availability, payment and delivery. Thank you!');
    return lines.join('\n');
  }

  function renderCart(){
    var n = count();
    countEl.textContent = n; countEl.dataset.n = n;
    fab.setAttribute('aria-label', 'Open cart, ' + n + (n === 1 ? ' item' : ' items'));
    if (!cart.length){
      body.innerHTML = '<div class="cart-empty"><strong>Your cart is empty</strong><span>Add a cap or a shirt to get started.</span>' +
        '<a class="btn btn-solid" href="#merch" data-close>Browse merch <span class="arr">↓</span></a></div>';
      foot.hidden = true;
      return;
    }
    body.innerHTML = cart.map(function(it, i){
      var p = product(it.id);
      return '<div class="cart-item" data-i="' + i + '">' +
        '<div class="cart-thumb"><img class="ph" src="images/logo.png" alt=""><img class="photo' + (p.cutout ? ' cutout' : '') + '" src="' + esc(p.image) + '" alt="" onload="this.parentNode.classList.add(\'has-photo\')" onerror="this.remove()"></div>' +
        '<div class="cart-info"><h4>' + esc(p.name) + '</h4>' +
          (it.option ? '<div class="meta">' + esc(p.options.label) + ': ' + esc(it.option) + '</div>' : '') +
          '<div class="meta">' + fmt(p.price) + ' each</div>' +
          '<div class="qty"><button type="button" data-act="dec" aria-label="Decrease quantity">−</button><span>' + it.qty + '</span><button type="button" data-act="inc" aria-label="Increase quantity">+</button></div></div>' +
        '<div class="cart-line"><b>' + fmt(p.price * it.qty) + '</b><button type="button" class="cart-remove" data-act="rm">Remove</button></div>' +
      '</div>';
    }).join('');
    totalEl.textContent = fmt(total());
    checkout.href = 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(buildMessage());
    foot.hidden = false;
  }

  body.addEventListener('click', function(e){
    if (e.target.closest('[data-close]')){ closeCart(); return; }
    var btn = e.target.closest('[data-act]'); if (!btn) return;
    var row = btn.closest('.cart-item'), it = cart[+row.dataset.i]; if (!it) return;
    var act = btn.dataset.act;
    if (act === 'inc') it.qty = Math.min(99, it.qty + 1);
    if (act === 'dec') it.qty -= 1;
    if (act === 'rm' || it.qty <= 0) cart.splice(+row.dataset.i, 1);
    save(); renderCart();
  });
  $('cartClear').addEventListener('click', function(){ cart = []; save(); renderCart(); });
  nameInput.addEventListener('input', function(){
    try { localStorage.setItem(NAME_KEY, nameInput.value); } catch(e){}
    if (cart.length) checkout.href = 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(buildMessage());
  });

  /* ---------- drawer open / close ---------- */
  function openCart(){
    lastFocus = document.activeElement;
    toast.classList.remove('show');
    overlay.classList.add('open'); drawer.classList.add('open');
    drawer.setAttribute('aria-hidden', 'false'); document.body.classList.add('cart-lock');
    setTimeout(function(){ $('cartClose').focus(); }, 50);
  }
  function closeCart(){
    overlay.classList.remove('open'); drawer.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true'); document.body.classList.remove('cart-lock');
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  fab.addEventListener('click', openCart);
  overlay.addEventListener('click', closeCart);
  $('cartClose').addEventListener('click', closeCart);
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && drawer.classList.contains('open')) closeCart();
    if (e.key === 'Tab' && drawer.classList.contains('open')){
      var f = drawer.querySelectorAll('button:not([hidden]), a[href], input'); f = Array.prototype.filter.call(f, function(x){ return x.offsetParent !== null; });
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
    }
  });

  function showToast(msg){
    toast.textContent = msg; toast.classList.add('show');
    clearTimeout(toastTimer); toastTimer = setTimeout(function(){ toast.classList.remove('show'); }, 2200);
  }

  load(); renderProducts('all'); renderCart();
})();